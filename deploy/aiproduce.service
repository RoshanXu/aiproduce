# AIproduce systemd 服务
# sudo cp deploy/aiproduce.service /etc/systemd/system/
# sudo systemctl daemon-reload
# sudo systemctl enable --now aiproduce

[Unit]
Description=AIproduce 小说改剧本 Web 服务
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/docker rm -f aiproduce 2>/dev/null || true
ExecStart=/usr/bin/docker run --rm --name aiproduce \
  --restart unless-stopped \
  -p 7860:7860 \
  -v aiproduce_workspace:/app/workspace \
  -v /opt/aiproduce/.env:/app/.env:ro \
  aiproduce:latest
ExecStop=/usr/bin/docker stop aiproduce

[Install]
WantedBy=multi-user.target
